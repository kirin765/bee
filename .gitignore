# ===== Unity generated =====
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Uu]ser[Ss]ettings/
MemoryCaptures/

# OS
.DS_Store
Thumbs.db

# Visual Studio / Rider
.vs/
.vscode/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd

# Mono
*.mdb

# Build output
*.apk
*.aab
*.unitypackage

# IMPORTANT: Unity .meta files MUST be committed. They hold the asset GUIDs that
# link scenes, prefabs and assets together. Ignoring them causes Unity to
# regenerate new GUIDs on every clone, breaking every reference (missing
# scripts, missing fonts/sprites, etc.).

# Don't check in local Unity Packages cache
/Library/PackageCache/

# Crash reports
/Crashes/

# Logs
*.log

# Ignore large generated files and temporary build artifacts
/Temp/
/obj/
.utmp/

# Apps in Toss Unity SDK build output
/webgl/
/ait-build/

# Apps in Toss deploy credentials (secret - never commit)
Assets/AppsInToss/Editor/AITCredentials.asset
Assets/AppsInToss/Editor/AITCredentials.asset.meta
